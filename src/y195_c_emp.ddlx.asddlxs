@Metadata.layer:#CUSTOMER


@UI: { 
 headerInfo : { 
    typeName: 'Employee',
    typeNamePlural: 'Employees',
    title: { type: #STANDARD, value: 'EmpName' },
    description: { value: 'Department' }
    }
 }



annotate entity Y195_C_EMP
    with 
{
@UI.facet: [
    {
      id: 'EmployeeSection',
      purpose: #STANDARD,
      type: #COLLECTION,
      label: 'General Information',
      position: 10
    },
    {
      id: 'EmployeeDetailsGroup',
      purpose: #STANDARD,
      type: #IDENTIFICATION_REFERENCE,
      parentId: 'EmployeeSection',
      label: 'Employee Details',
      position: 10
    },
    {
      id: 'LeaveRequestsFacet',
      purpose: #STANDARD,
      type: #LINEITEM_REFERENCE,
      label: 'Leave Requests',
      position: 20,
      targetElement: '_LeaveRequests'
    }
  ]
  
  @UI: {
    lineItem:       [ { position: 10, label: 'Employee ID' } ],
    identification: [ { position: 10, label: 'Employee ID' } ],
    selectionField: [ { position: 10 } ]
  }
  EmpId;

  @UI: {
    lineItem:       [ { position: 20, label: 'Name' } ],
    identification: [ { position: 20, label: 'Name' } ],
    selectionField: [ { position: 20 } ]
  }
  EmpName;

  @UI: {
    lineItem:       [ { position: 30, label: 'Department' } ],
    identification: [ { position: 30, label: 'Department' } ],
    selectionField: [ { position: 30 } ]
  }
  Department;

  @UI: {
    lineItem:       [ { position: 40, label: 'Email' } ],
    identification: [ { position: 40, label: 'Email' } ]
  }
  Email;

  @UI: {
    lineItem:       [ { position: 50, label: 'Joining Date' } ],
    identification: [ { position: 50, label: 'Joining Date' } ]
  }
  JoiningDate;

  @UI: {
    lineItem:       [ { position: 60, label: 'Leave Balance' } ],
    identification: [ { position: 60, label: 'Leave Balance' } ]
  }
  LeaveBalance;
    
}