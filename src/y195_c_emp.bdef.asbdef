projection;
strict ( 2 );
use draft;

define behavior for Y195_C_EMP alias Employee
{
  use create;
  use update;
  use delete;


  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

   use association _LeaveRequests { create; with draft;}
}

define behavior for Y195_C_LEAVE_REQ alias LeaveRequest
{
  use update;
  use delete;

  use action approveLeave;
  use action rejectLeave;

  use association _Employee {with draft; }
}